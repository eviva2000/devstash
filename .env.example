DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Optional: set when Prisma Migrate needs a separate shadow database.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/SHADOW_DB?sslmode=require"

# Email verification is enabled by default. Set to false locally if Resend
# cannot send from your domain yet.
EMAIL_VERIFICATION_ENABLED=false

# Upstash Redis for auth rate limiting. Fails open if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical public app origin for verification/reset email links (required in production).
APP_URL="http://localhost:3000"
